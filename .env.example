# Copy to .env and fill in. Never commit the real .env file.

# --- Telegram Approval Gateway ---
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram numeric user IDs allowed to approve/reject.
# Get your ID from @userinfobot. Approvals from any other user/chat are rejected.
TELEGRAM_ALLOWED_USER_IDS=

# --- Storage ---
# Path to the local SQLite database file.
DATABASE_PATH=./data/bug-bounty-agent.sqlite

# --- Claude Agent Runtime ---
# Optional: pin a specific model alias for research/report tasks (default: sonnet).
CLAUDE_MODEL=sonnet
# Optional: hard USD cap per `claude -p` invocation (research/report tasks).
CLAUDE_MAX_BUDGET_USD=1.00

# --- Safari MCP ---
# Path to the built Safari MCP server entrypoint used by the agent runtime.
SAFARI_MCP_ENTRYPOINT=./src/safari/mcp-server.ts
